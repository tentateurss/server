# dist/plugins/ — built jars, tracked (exception to NetBeans dist/ rule
# и общему *.jar). Включает каталог обратно, чтобы jars попадали в git.
!dist/
!dist/plugins/
!dist/plugins/*.jar

# Minecraft server runtime — миры, кэши, логи генерируются на лету
